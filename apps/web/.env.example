# ------------------------------------------------------------------
# Galinheiro Idle — variáveis de ambiente
# Copie para .env.local. Em desenvolvimento NADA é obrigatório:
# sem DATABASE_URL o app usa um PostgreSQL embutido (PGlite) em .data/
# ------------------------------------------------------------------

# Banco PostgreSQL de produção (ex.: Supabase, pooler em modo transação, porta 6543).
# DATABASE_URL=postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Pasta do banco embutido (somente quando DATABASE_URL não estiver definida).
# PGLITE_DIR=.data/pglite

# Segredo para assinar as sessões (obrigatório em produção; 32+ caracteres aleatórios).
# AUTH_SECRET=

# Notificações push (gere com: pnpm --filter @galinheiro/web vapid).
# Em desenvolvimento, se ausentes, são geradas e salvas em .data/vapid.json.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@seudominio.com.br

# Protege o endpoint /api/cron/tick (Vercel Cron ou agendador externo).
# CRON_SECRET=

# Agendador interno (aposentadorias + push a cada 60 s). Padrão: ligado.
# JOBS_INTERNOS=1

# Relógio ajustável para testes (só funciona fora de produção).
# DEV_RELOGIO=1

# Saque PIX pela LofyPay. A chave secreta (sk_live_ ou sk_test_) fica só no servidor.
# 1,00 moeda do jogo = R$ 1,00. Mínimo em centavos (padrão 100 = R$ 1,00).
# LOFYPAY_SECRET_KEY=sk_test_...
# LOFYPAY_WEBHOOK_SECRET=
# LOFYPAY_API_URL=https://app.lofypay.com/api/v1
# PIX da roleta também aceita KavroPay. A gateway ativa troca no painel (/admin/pagamentos).
# KAVROPAY_SECRET_KEY=kvk_live_...
# KAVROPAY_WEBHOOK_SECRET=
# KAVROPAY_API_URL=https://api.kavropay.online/v1
# KAVROPAY_WEBHOOK_URL=https://seu-dominio/api/webhooks/kavropay
# PIX e saque escolhem a gateway no painel (/admin/pagamentos). O segredo do webhook aparece uma vez, ao cadastrar o endereço.
# SWYTCHPAY_API_KEY=ak_live_...
# SWYTCHPAY_API_SECRET=sk_live_...
# SWYTCHPAY_WEBHOOK_SECRET=
# SWYTCHPAY_API_URL=https://api.go.swytchpay.app/v1
# Mínimo que precisa cair no PIX. A taxa (R$ 5 + 4%) sai por cima, do saldo.
# SAQUE_MINIMO_CENTAVOS=100
# Webhook (cadastrar no painel da LofyPay):
# eventos saque.paid, saque.failed, pix.paid e payment.approved
# https://seu-dominio/api/webhooks/lofypay
# Webhook KavroPay (payment.paid, payment.confirmed, payment.expired, payment.refunded):
# https://seu-dominio/api/webhooks/kavropay
# Webhook SwytchPay (deposit.paid, deposit.expired, deposit.canceled, payout.paid, payout.failed, payout.canceled, payout.returned):
# https://seu-dominio/api/webhooks/swytchpay
# O giro da roleta custa o valor de CONFIG.roleta.custoX100 em centavos (hoje R$ 55,00) e só gira depois do PIX pago.
# A ampliação do galinheiro custa CONFIG.galinheiro.custoUpgradeX100 (hoje R$ 25,00) e só sobe o nível depois do PIX pago.

# Login do painel administrador (/admin), separado das contas do jogo. Gere a linha do hash com:
#   pnpm --filter @galinheiro/web senha-admin
# (só o hash fica aqui, nunca a senha; trocar o hash derruba as sessões abertas do painel)
# ADMIN_USUARIO=seu.usuario
# ADMIN_SENHA_HASH=scrypt:16384:8:1:...
# Nome que os membros veem nas respostas do atendimento. Padrão: Equipe Galinheiro
# ADMIN_NOME=Equipe Galinheiro

# Opcional: contas do JOGO (e-mails separados por vírgula) que também entram no painel. Cadastre o e-mail
# no jogo antes de colocá-lo aqui (não há verificação de e-mail).
# ADMIN_EMAILS=dono@seudominio.com.br
